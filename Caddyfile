# Reverse proxy + automatic TLS for the self-hosted backend.
# Swap the hostname (and PUBLIC_BASE_URL in .env) to move domains.
rovertools-temp.ctx.cl {
	encode zstd gzip

	reverse_proxy {
		# Re-resolve `api` on each request via Docker's embedded DNS (127.0.0.11)
		# so a request always finds the current container. `resolvers` is a
		# subdirective of `dynamic a`, so it sits inside its block.
		dynamic a {
			name api
			port 8000
			resolvers 127.0.0.11
		}
		# Deploys recreate the single `api` container, leaving a ~3s gap with no
		# backend. Rather than 502 during it, hold the request and retry the dial
		# until the new container answers: it arrives a couple seconds late instead
		# of failing. Retrying a dial that never connected is safe for any method.
		# This is why we don't need docker-rollout for HTTP; WebSockets still drop
		# once and reconnect. See docs/DEPLOY.md section 9.
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}
