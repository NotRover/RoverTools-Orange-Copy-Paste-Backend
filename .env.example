# Copy to .env and fill in values before running

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipboard

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./private.pem
JWT_PUBLIC_KEY_PATH=./public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cloudflare R2 (S3-compatible API) ────────────────────────────────────────
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=clipboard-blobs
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_REGION=auto

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_CORS_ORIGINS=tauri://localhost,http://localhost:1420
DEFAULT_BLOB_QUOTA_BYTES=524288000

# ── Email ─────────────────────────────────────────────────────────────────────
# Provider: "brevo" (default) or "smtp"
EMAIL_PROVIDER=brevo

# Brevo — get your API key from app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=your-brevo-api-key-here
EMAIL_FROM=Orange Clipboard <noreply@yourdomain.com>

# SMTP fallback (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme

# ── App ───────────────────────────────────────────────────────────────────────
# Base URL for links inside emails (verify-email, reset-password)
APP_BASE_URL=http://localhost:1420
