# Copy to .env and fill in values before running

# ── Database ──────────────────────────────────────────────────────────────────
# Prod: Supabase → Project Settings → Database → Connection string (URI), with the
# asyncpg driver, e.g.
#   postgresql+asyncpg://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
# Dev: local Postgres (docker-compose).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipboard

# ── Redis (pub/sub fan-out + device presence) ─────────────────────────────────
# Dev: local. Prod: managed Redis (e.g. Upstash) — rediss:// URL.
REDIS_URL=redis://localhost:6379/0

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# We verify the JWTs Supabase issues; we never sign our own.
# Required. Also determines the JWKS endpoint used to verify asymmetric tokens.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Legacy symmetric secret — LEAVE BLANK on projects created from 2025-10-01
# onward, which sign with asymmetric keys (ES256) verified via JWKS automatically.
# Only set this for an older project that still signs HS256; find it under
# Settings → JWT Keys. Both schemes are accepted, so a project mid-migration works.
SUPABASE_JWT_SECRET=

# Server-only, for admin ban/delete via the Supabase Admin API.
# Settings → API Keys → a secret key (`sb_secret_…`), or the legacy `service_role`
# key (deprecated by Supabase at the end of 2026). NEVER expose this to clients.
SUPABASE_SERVICE_ROLE_KEY=

# ── Blob storage — Cloudflare R2 (S3-compatible) in prod, MinIO in dev ────────
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=clipboard-blobs
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_REGION=auto

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_CORS_ORIGINS=tauri://localhost,http://localhost:1420
# Swagger UI, ReDoc and the OpenAPI schema. Off unless set, so a deployment that
# configures nothing does not publish a map of its own admin surface.
DOCS_ENABLED=true
# Default per-user blob quota (bytes). 50 MB. Per-user overrides via the admin API.
DEFAULT_BLOB_QUOTA_BYTES=52428800

# ── Email (sharing invites only) ──────────────────────────────────────────────
# Verification + password reset are handled by Supabase Auth, not here.
# Provider: "brevo" (default) or "smtp"
EMAIL_PROVIDER=brevo
# Brevo — get your API key from app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=your-brevo-api-key-here
EMAIL_FROM=Orange Clipboard <noreply@yourdomain.com>
# SMTP fallback (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme

# ── Admin ─────────────────────────────────────────────────────────────────────
# Required to access /internal/metrics, /internal/v1/stats, /internal/v1/admin/*
# Leave empty to disable admin endpoints (they return 503).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=

# -- Metrics dashboard auth (self-hosted VPS only) ----------------------------
# Read by Caddy, never by the app. Netdata's dashboard has no login of its own,
# so Caddy puts basic auth in front of it. Generate the hash on the box with:
#   docker run --rm -it caddy:2-alpine caddy hash-password
# and paste the whole $2a$... string. See docs/DEPLOY.md section 12.
METRICS_AUTH_USER=admin
METRICS_AUTH_HASH=
