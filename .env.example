# Copy to .env and fill in values before running

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipboard

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./private.pem
JWT_PUBLIC_KEY_PATH=./public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=clipboard-blobs
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_CORS_ORIGINS=tauri://localhost,http://localhost:1420
DEFAULT_BLOB_QUOTA_BYTES=524288000

# ── Email (Celery task) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme
EMAIL_FROM=Orange Clipboard <noreply@example.com>
