# Reverse proxy + automatic TLS for the self-hosted backend.
# Swap the hostname (and PUBLIC_BASE_URL in .env) to move domains.
api.orangecp.rovertools.ctx.cl {
	encode zstd gzip

	# HSTS at the edge. Deferred so it replaces, rather than duplicates, the copy
	# the API sets itself once it trusts X-Forwarded-Proto.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		defer
	}

	# The admin API and the metrics endpoint are not for the internet. Both still
	# need the admin key, but nothing outside the box has a reason to reach them,
	# so they answer 404 here. /internal/metrics is scraped from inside the compose
	# network only (nothing external scrapes it), so it is blocked too. Reach them
	# from the box: `docker compose -f docker-compose.prod.yml exec api curl ...`.
	# /internal/healthz stays public for uptime checks.
	@internal {
		path /internal/*
		not path /internal/healthz
	}
	respond @internal 404

	reverse_proxy {
		# Re-resolve `api` on each request via Docker's embedded DNS (127.0.0.11),
		# so after a deploy recreates the container Caddy finds its new IP instead
		# of caching the dead one. `resolvers` is a subdirective of `dynamic a`, so
		# it sits inside its block (a bare `resolvers` under reverse_proxy does not
		# parse and crash-loops caddy).
		dynamic a {
			name api
			port 8000
			resolvers 127.0.0.11
		}
		# No lb_try_duration here on purpose: with one `api` container a deploy
		# leaves a ~1-3s window with no backend at all, and retry/failover cannot
		# reach a host that is not there — measured on the box, it still 502s. The
		# gap is accepted rather than papered over. See docs/DEPLOY.md section 9.
	}
}

# Netdata dashboard. Register this name in FreeDNS (A -> the box) BEFORE deploying,
# or Caddy will retry a cert it cannot validate.
#
# Basic auth is not optional here. The Netdata agent dashboard has no login of its
# own and reports processes, listening ports, disk layout and container internals -
# published bare it is a free reconnaissance page for the box. Credentials come from
# .env via the caddy service's environment (docs/DEPLOY.md section 12); Caddy refuses
# to start if METRICS_AUTH_HASH is unset, which is the intended failure.
status.rovertools.ctx.cl {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		defer
	}

	# Source allow-list. METRICS_ALLOW_CIDR is space-separated CIDRs from .env,
	# substituted when the Caddyfile is loaded; the compose default is everyone,
	# with basic auth still in front. Narrow it to your own address(es) to take
	# the dashboard off the internet entirely (docs/DEPLOY.md section 12).
	@not_allowed not remote_ip {$METRICS_ALLOW_CIDR:0.0.0.0/0 ::/0}
	respond @not_allowed 403

	basic_auth {
		{env.METRICS_AUTH_USER} {env.METRICS_AUTH_HASH}
	}

	# Netdata streams over websockets for live charts; Caddy proxies the upgrade
	# with no extra config.
	reverse_proxy netdata:19999
}
