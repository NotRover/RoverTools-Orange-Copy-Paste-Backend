# These run on the Linux VPS; CRLF would break the shebang / systemd parsing.
# Pin LF regardless of anyone's core.autocrlf.
*.sh              text eol=lf
Dockerfile        text eol=lf
caddy/Caddyfile   text eol=lf
docker-compose*.yml text eol=lf
deploy/rovertools-deploy.service text eol=lf
deploy/rovertools-deploy.timer   text eol=lf
netdata/conf/**/*.conf   text eol=lf
netdata/conf/*.conf      text eol=lf
