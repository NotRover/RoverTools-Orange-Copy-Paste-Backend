# Install to /etc/systemd/system/rovertools-deploy.service (see docs/DEPLOY.md section 9).
# One-shot deploy check, driven by rovertools-deploy.timer. Runs as the login user
# that owns the checkout (in the docker group). Adjust User= and the paths if you
# cloned somewhere other than /home/ubuntu/app.
[Unit]
Description=RoverTools backend: poll origin/main and deploy on change
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/app
ExecStart=/bin/bash /home/ubuntu/app/deploy/deploy.sh
# deploy.sh defaults GIT_SSH_COMMAND to ~/.ssh/id_repo, so no key path is needed here.
TimeoutStartSec=600
